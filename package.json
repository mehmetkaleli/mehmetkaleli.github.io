{
	"name": "mehemtkaleli",
	"version": "9.0.0",
	"description": "A repository for a peroanl web site using the Eleventy site generator.",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
		"build-ghpages": "npx @11ty/eleventy --pathprefix=/mehmetkaleli/",
		"start": "npx @11ty/eleventy --serve --quiet",
		"start-ghpages": "npx @11ty/eleventy --pathprefix=/mehmetkaleli/ --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/mehmetkaleli/mehmetkaleli.git"
	},
	"author": "Mehmet Kaleli",
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/11ty"
	},
	"bugs": {
		"url": "https://github.com/mehmetkaleli/mehmetkaleli/issues"
	},
	"homepage": "https://github.com/mehmetkaleli/mehmetkaleli#mehmet-kaleli",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.8",
		"@11ty/eleventy-img": "^7.1.1",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.1.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"cross-env": "^10.1.0",
		"luxon": "^3.7.2",
		"prismjs": "^1.30.0",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"@zachleat/heading-anchors": "^1.0.5"
	}
}
